stdin=serial
stderr=vidconsole,serial
stdout=vidconsole,serial
baudrate=115200

loadaddr=0x40000000
initrd_high=0xffffffffffffffff

# default number of blocks to read from mmc, 120MB.
mmcblocks=0x3C000

load0=mmc read $loadaddr 0x04000 ${mmcblocks}; \
 setenv bootargs itbload=0 application=${application};
load1=mmc read $loadaddr 0x40000 ${mmcblocks}; \
 setenv bootargs itbload=1 application=${application};

application=vanilla
bootdelay=2
bootretry=120
preboot=echo preboot - hello
bootnet=setenv autoload no; \
 dhcp; \
 tftp ${loadaddr} nl-industrial.itb; \
 setenv bootargs itbload=net application=${application}; \
 bootm ${loadaddr}#${application}; \
 setenv bootargs itbload=net application=default; \
 bootm ${loadaddr};

bootmmc=run load0; bootm ${loadaddr}#${application}; \
 run load1; bootm ${loadaddr}#${application};

bootcmd=run bootmmc; run bootnet; echo boot options failed; sleep 5; reset; 
